# Telegram bot token (required)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Shared secret between Bot and Gateway (required).
# Generate with: openssl rand -hex 24
INTERNAL_TOKEN=change_me_to_a_random_secret

# Infrastructure credentials (optional, defaults are fine for local runs;
# change them on any shared/public host).
# NOTE: POSTGRES_PASSWORD only takes effect on a fresh postgres volume.
#RABBITMQ_USER=pricescount
#RABBITMQ_PASSWORD=pricescount
#POSTGRES_PASSWORD=pricescount

# Stable identity for fresh installs. For broker data restoration, set BOTH
# values to the actual old hostname and exact node name recorded before shutdown.
# Do not guess these values: RabbitMQ Mnesia data is tied to its node name.
#RABBITMQ_HOSTNAME=pricescount-rabbitmq
#RABBITMQ_NODENAME=rabbit@pricescount-rabbitmq
# For a previously configured long node name, also set this to true and rehearse.
#RABBITMQ_USE_LONGNAME=false
